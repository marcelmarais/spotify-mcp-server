# Copy to .env (or export in your shell) before `docker compose up`.
#
# Only ONE value is relevant for the OAuth deployment:
#
#   SPOTIFY_RESOURCE_URL  The URL the MCP client (MCPHub) uses to reach the
#                         Spotify MCP server. In the default compose file this
#                         is the internal Docker DNS name. The server advertises
#                         this exact value in its RFC 9728 metadata
#                         (".well-known/oauth-protected-resource").
#
#                         Default: http://spotify-mcp:3000
#
#                         Set this instead if you run MCPHub on another host
#                         or behind a reverse proxy, e.g.
#                         http://192.168.1.50:3999 or https://mcp.example.com/spotify
#
# NOTE: The Spotify client ID lives in MCPHub's OAuth configuration, NOT here.
#       This image needs no client secret, no refresh token and no
#       spotify-config.json.

SPOTIFY_RESOURCE_URL=http://spotify-mcp:3000
